# Base da API (com prefixo /api/v1).
#
# Recomendado na VPS enquanto NÃO existir DNS para api.ondeachotea.com:
#   NEXT_PUBLIC_API_URL=/api/v1
# O browser usa o mesmo host do site; o Next faz proxy para o Nest (next.config.js → WEB_API_PROXY_TARGET).
#
# Quando api.ondeachotea.com estiver com A + Nginx + TLS, podes usar URL absoluta:
#   NEXT_PUBLIC_API_URL=https://api.ondeachotea.com/api/v1
# (exige CORS na API para https://ondeachotea.com e https://www.ondeachotea.com.)

NEXT_PUBLIC_API_URL=/api/v1

# URL pública do site (opcional)
NEXT_PUBLIC_SITE_URL=https://ondeachotea.com

# Desligar logs de URL no console (padrão: ligado). Defina 0 para silenciar.
# NEXT_PUBLIC_API_LOG_REQUESTS=0
