# Embutido no `next build`. Mesma origem que o admin: o browser chama
# https://admin.ondeachotea.com/api/v1/... e o Next (rewrites em next.config.js)
# encaminha para o Nest em ADMIN_API_PROXY_TARGET (default 127.0.0.1:3000).
# Não depende de DNS para api.ondeachotea.com.
NEXT_PUBLIC_API_URL=/api/v1
# Quem abre /redefinir-senha no admin (link antigo no e-mail) é enviado para o site público, onde a página existe.
NEXT_PUBLIC_PUBLIC_WEB_ORIGIN=https://ondeachotea.com
