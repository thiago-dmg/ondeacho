# Base da API (prefixo /api/v1).
#
# Produção na VPS (recomendado enquanto não houver DNS para api.ondeachotea.com):
#   NEXT_PUBLIC_API_URL=/api/v1
# O browser usa o mesmo host do admin; o Next faz proxy para o Nest (next.config.js).
#
# Com subdomínio api a funcionar:
#   NEXT_PUBLIC_API_URL=https://api.ondeachotea.com/api/v1
# (exige CORS na API com https://admin.ondeachotea.com.)

# Em `next dev`, se não definir nada, o admin usa http://127.0.0.1:3000/api/v1 (Nest local).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3000/api/v1

# Legado (opcional):
# NEXT_PUBLIC_API_BASE_URL=https://api.ondeachotea.com/api/v1

# Desligar logs de URL no console (padrão: ligado). Defina 0 para silenciar.
# NEXT_PUBLIC_API_LOG_REQUESTS=0

# Produção: se o e-mail de reset ainda apontar a admin.../redefinir-senha, o admin redirecciona para o site público.
# Ex.: https://ondeachotea.com (sem barra final). Em dev local pode omitir.
# NEXT_PUBLIC_PUBLIC_WEB_ORIGIN=https://ondeachotea.com
