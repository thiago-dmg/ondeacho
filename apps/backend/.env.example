PORT=3000
JWT_SECRET=trocar_em_producao
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ondeacho
# Origens permitidas (separadas por vírgula). Em NODE_ENV=production o Nest inclui sempre
# https://ondeachotea.com, https://www..., https://admin... (+ variantes http) — podes acrescentar mais aqui.
# Em desenvolvimento, sem esta variável, usa localhost:3001/3002.
#
# Produção (/etc/ondeacho-api.env) — opcional se só usares os domínios acima (já embutidos):
# CORS_ORIGINS=
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://127.0.0.1:3001,http://127.0.0.1:3002
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# SendGrid (e-mail transacional: reset de senha e tickets de suporte)
SENDGRID_API_KEY=
# Remetente verificado no SendGrid (ex.: suporte@ondeachotea.com)
SENDGRID_FROM=suporte@ondeachotea.com
# Opcional: caixa que recebe /support/message (por defeito = SENDGRID_FROM)
# SUPPORT_INBOX_EMAIL=suporte@ondeachotea.com

# URL pública da página /redefinir-senha (site Next web, sem barra final)
PASSWORD_RESET_PUBLIC_URL=http://localhost:3002
